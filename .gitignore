# Claude Code harness state -- session-local, not project content
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Project outputs (regenerated by scripts in scripts/ and validation/).
# Extended from the original figures/+models/-only version: mle_fits/,
# training_history/, and _archive/ were previously UNTRACKED AND NOT IGNORED
# -- a plain `git add -A` would have picked all of it up, results/_archive/
# alone being hundreds of old figures from abandoned model architectures.
#
# results/validation/ is DELIBERATELY tracked (see below), unlike the rest of
# results/ -- it's the actual evidence backing GRIN's validation claims, not
# bulk regenerable figures, and it's small/diffable in a way PNGs aren't.
#
# results/_archive/ uses a different (3-line) pattern than the flat dirs
# below it: it has real nested subdirectories (results/_archive/figures/
# model_eval/Attention/..., 4 levels deep), and a plain `dir/*` pattern
# silently swallows .gitkeep past the first level of nesting -- confirmed
# empirically. `!results/_archive/**/` explicitly keeps every directory
# under it traversable, so `!**/.gitkeep` can still reach the ones nested
# inside.
results/figures/*
results/models/*
results/mle_fits/*
results/training_history/*
results/_archive/**
!results/_archive/**/
!**/.gitkeep

# results/validation/ -- tracked, not ignored. Same nested-directory handling
# as _archive/ above (results/validation/sweeps/ is nested inside), but with
# explicit exceptions for the actual evidence: the v01-v16 checks, their
# SUMMARY, and the sweep configs that produced them.
results/validation/**
!results/validation/**/
!results/validation/*.json
!results/validation/SUMMARY.md
!results/validation/sweeps/*.json

data/raw/*
data/processed/*
data/simulated/*
data/simulated_grt/*
!**/.gitkeep

# tests/ deliberately NOT ignored -- the JS regression suite lives here and
# should be tracked. The reference JSON files ARE generated (by gen_reference.py,
# gen_io_reference.py, get_fit_reference.py) and should NOT be tracked -- they are
# regenerated fresh by tests/run_web.sh / CI each run, from the real Python package.
tests/reference.json
tests/io_reference.json
tests/fit_reference.json

www/
# the pre-collaboration prototype -- confirmed archived, not the live site

# Windows
Thumbs.db

# Credentials -- defensive, given deploy-infra.sh prints an AWS secret key to
# the terminal; cheap insurance against ever committing a copy-pasted scratch file
.env
.env.*
*.pem
.aws/

