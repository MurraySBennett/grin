{
  "id": "cm",
  "label": "GRIN — counts only",
  "description": "Infers the 12 identified GRT parameters plus the PI/RHO1/free and separability constructs from a 4x4 confusion matrix.",
  "file": "npe_model.onnx",
  "version": "0.0.0-pending",
  "exported_by": "scripts/export_onnx.py",
  "inputs": [
    {
      "name": "counts",
      "dim": 16,
      "note": "row-major 4x4, rows=stimuli, cols=responses, canonical order"
    },
    { "name": "trials", "dim": 4, "note": "row sums" }
  ],
  "outputs": {
    "mean": { "dim": 12, "note": "posterior mean, parameter space" },
    "std": { "dim": 12, "note": "posterior marginal SD, parameter space" },
    "p_corr": { "dim": 3, "names": ["pi", "rho1", "free"] },
    "p_sep": { "dim": 2, "names": ["A", "B"] }
  },
  "params": {
    "names": [
      "zx_0",
      "zx_1",
      "zx_2",
      "zx_3",
      "zy_0",
      "zy_1",
      "zy_2",
      "zy_3",
      "rho_0",
      "rho_1",
      "rho_2",
      "rho_3"
    ],
    "stimulus_order": ["A1B1", "A1B2", "A2B1", "A2B2"]
  },
  "training": {
    "n_per_class": 20000,
    "trial_range": [1, 1000],
    "trial_sampling": "log-uniform",
    "z_max": 3.0,
    "r_max": 0.9,
    "seed": 42,
    "note": "Amortized over this prior. Input outside it gets a confident answer that means nothing."
  }
}
